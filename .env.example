# Astra MD Environment Variables
# Copy this file to .env and fill in your values

# Supabase Configuration
VITE_SUPABASE_URL=https://shwitfgtpfszjjoczbxp.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# API URLs
VITE_BILLING_API_URL=https://shwitfgtpfszjjoczbxp.supabase.co/functions/v1/billing-supabase
VITE_PRICING_API_URL=https://shwitfgtpfszjjoczbxp.supabase.co/functions/v1/pricing
VITE_QUICK_API_URL=https://shwitfgtpfszjjoczbxp.supabase.co/functions/v1/quick-api
VITE_AUTH_API_URL=https://shwitfgtpfszjjoczbxp.supabase.co/functions/v1/auth-management

# Server-only secrets
# Set Edge Function secrets with `supabase secrets set`; never prefix these with VITE_.
OPENAI_API_KEY=your_openai_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
USAGE_HASH_SECRET=your_random_server_only_hmac_secret

# Local article-generation script
SUPABASE_ANON_KEY=your_supabase_anon_key_here
