# Resend API Configuration
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_RESEND_API_KEY_HERE

# Supabase Auth Hook Secret
# This will be generated when you configure the Auth Hook in Supabase Dashboard
# Go to: Authentication > Hooks > Create "Send Email" hook
SEND_EMAIL_HOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Email Configuration
# The email address that will appear as the sender
# Format: "Name <email@domain.com>"
EMAIL_FROM=ASTRA MD <noreply@yourdomain.com>

# Site URL (for email links)
# Your production URL where the app is hosted
SITE_URL=https://yourdomain.com

# Optional: Supabase Configuration (if not already set)
# These are typically already set in Supabase Edge Functions environment
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here